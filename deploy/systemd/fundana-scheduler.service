[Unit]
Description=Fund-ANA daily scheduler
Documentation=file://~/fund/docs/runbook.md
After=network-online.target
Wants=network-online.target
OnFailure=fundana-alert@%N.service

[Service]
Type=notify
WorkingDirectory=~/fund
Environment=TZ=Asia/Shanghai
Environment=PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
ExecStart=/usr/bin/python3 -u -m fundana scheduler
Restart=on-failure
RestartSec=5
WatchdogSec=300
NotifyAccess=all
TimeoutStartSec=30
TimeoutStopSec=15

[Install]
WantedBy=default.target
